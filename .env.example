# Copy this file to .env and fill in your own iLO2's details.
# .env is gitignored -- it never gets committed.

ILO_HOST=192.168.1.100
ILO_USER=Administrator
ILO_PASSWORD=changeme

# Optional: gates the web client (login page + session cookie) behind a
# separate username/password -- distinct from the iLO2 credentials above,
# so a leaked dashboard session never exposes those. Leave both unset to
# run without login (fine on a trusted LAN; NOT fine on the open internet).
# Required if this is reachable from outside your LAN. Put a TLS-terminating
# reverse proxy in front either way -- see README.
WEBAPP_USER=
WEBAPP_PASSWORD=
